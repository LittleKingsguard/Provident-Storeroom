+  process.stdout.write(`${JSON.stringify({
+    gc: typeof globalThis.gc === 'function',
+    writes: WRITES,
+    seals: kernel.closedSeals,
+    maxSize,
+    survivors,
+    maxRise,
+    midMax,
+    finalSize: kernel.closedIds.size,
+  })}\n`);
+  process.exit(0);
