+      + `\`['nowhere']\` ran ${absent.calls.length} time(s)`);
+
+  t.diagnostic(`CAW-4 · THE BOOT WITH NO CONSTRAINTS: the construction `
+    + `${construction.ok ? 'returned its instance' : 'refused'}; the resolving address fired `
