{
  "name": "provident-storeroom",
  "version": "0.2.0",
  "description": "U-STOREROOM-PUBLISH: the published Node ESM binding for the native Rust store of Provident-Storeroom — the entry resolves the scoped per-target platform package first, the checkout's own module-relative addon second, and answers the store's single declared absent-addon form when neither loads",
  "type": "module",
  "license": "AGPL-3.0",
  "author": "Auspicion Innovations LLC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LittleKingsguard/Provident-Storeroom.git"
  },
  "homepage": "https://github.com/LittleKingsguard/Provident-Storeroom#readme",
  "bugs": {
    "url": "https://github.com/LittleKingsguard/Provident-Storeroom/issues"
  },
  "keywords": [
    "provident-storeroom",
    "store",
    "rust",
    "node-api",
    "esm",
    "binding"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "exports": {
    ".": {
      "import": "./index.mjs"
    }
  },
  "types": "index.d.ts",
  "files": [
    "index.mjs",
    "README.md",
    "index.d.ts"
  ],
  "optionalDependencies": {
    "@auspicion/provident-storeroom-js-linux-x64-gnu": "0.2.0",
    "@auspicion/provident-storeroom-js-linux-arm64-gnu": "0.2.0",
    "@auspicion/provident-storeroom-js-darwin-x64": "0.2.0",
    "@auspicion/provident-storeroom-js-darwin-arm64": "0.2.0",
    "@auspicion/provident-storeroom-js-win32-x64-msvc": "0.2.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
