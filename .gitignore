vite.config.js.timestamp-*
vite.config.ts.timestamp-*
.vite/

# Astro generated types
.astro/

# Turbo Repo
.turbo

# Rust build output
/target

# Archival (the process rule: archive/ is GITIGNORED)
archive/

# A role's in-flight backup directory. Backup trees for a re-flow pass belong OUTSIDE the
# repository or under the gitignored archive/ -- never in the tree, because a `git add -A`
# in another pass's commit sweeps them in and a backup tree is not a project artifact.
.reflow-backup/

# Another role's in-flight backup directory. Same rule as above: a backup tree belongs
# outside the repository or under the gitignored archive/, never in the tree.
.impl-rc8-backup/

# The supervisor's own in-flight tracker backup, same rule as the others.
.tracker-reflow-backup/

# Generated npm cache (the LIVE/INSTALL battery installs into scratch/live/)
.npm-cache/

# The live battery's copy-drive (a duplicate of the checkout's own files, rebuilt by the report's own commands)
scratch/live/install-0.2.0/drive/
scratch/probe-shape-a/

# Gate-6/10 archival staging (scratch verification byproducts, never deliverables)
scratch/g7-cache/
scratch/g7-consumer/
scratch/g7-logs/
scratch/g7-stage/
